  var subject = 'Fee Payment Receipt — ' + payment.receipt_no;
  var body = '<p>Dear <b>' + student.full_name + '</b>,</p>' +
    '<p>We have successfully received and acknowledged your fee payment with details below:</p>' +
    '<div style="background-color: #F8FAFC; border: 1px solid #CBD5E1; border-radius: 8px; padding: 18px; margin: 20px 0; font-size: 14px;">' +
    '<table width="100%" cellpadding="4">' +
    '<tr><td><b>Receipt Number:</b></td><td style="font-family: monospace; font-weight: bold; color: #0A3FB5;">' + payment.receipt_no + '</td></tr>' +
    '<tr><td><b>Installment:</b></td><td>' + installment.title + '</td></tr>' +
    '<tr><td><b>Amount Paid:</b></td><td><b style="color: #059669; font-size: 16px;">' + formatINR(payment.amount) + '</b></td></tr>' +
    '<tr><td><b>Payment Mode:</b></td><td>' + payment.payment_mode + '</td></tr>' +
    '<tr><td><b>Transaction Reference:</b></td><td>' + (payment.reference_no || 'N/A') + '</td></tr>' +
    '<tr><td><b>Payment Date:</b></td><td>' + new Date(payment.payment_date).toLocaleDateString('en-IN') + '</td></tr>' +
    '</table>' +
    '</div>' +
    '<p>Thank you for your timely payment. You can access your full fee ledger anytime via the Student Portal.</p>';

  var html = wrapEmailTemplate('Fee Payment Receipt', body);
  var targetEmail = student.personal_email || student.professional_email;
  return sendEmailWithLog(targetEmail, subject, html, [], 'FEE_RECEIPT');
}
