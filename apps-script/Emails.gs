/**
 * Branded HTML Email Container Wrapper
 */
function wrapEmailTemplate(title, bodyContent, actionBtn) {
  var instName = CONFIG.getInstituteName();
  var btnHtml = '';
  if (actionBtn && actionBtn.text && actionBtn.url) {
    btnHtml = '<div style="text-align:center; margin: 30px 0;">' +
      '<a href="' + actionBtn.url + '" style="background: linear-gradient(135deg,#C9930A,#F5B921 45%,#FFE08A 70%,#F5B921); color: #061B4D; font-weight: bold; text-decoration: none; padding: 14px 28px; border-radius: 8px; display: inline-block; box-shadow: 0 4px 12px rgba(245,185,33,0.3);">' +
      actionBtn.text +
      '</a>' +
      '</div>';
  }

  return '<!DOCTYPE html>' +
    '<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"></head>' +
    '<body style="margin: 0; padding: 0; background-color: #F4F7FD; font-family: -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, Helvetica, Arial, sans-serif; color: #0B1530;">' +
    '<table width="100%" border="0" cellspacing="0" cellpadding="0" style="background-color: #F4F7FD; padding: 30px 10px;">' +
    '<tr><td align="center">' +
    '<table width="100%" max-width="600" style="max-width: 600px; background-color: #ffffff; border-radius: 14px; overflow: hidden; box-shadow: 0 8px 24px rgba(6,27,77,0.08); border-top: 4px solid #F5B921;">' +
    // Branded Header
    '<tr><td style="background: linear-gradient(135deg,#061B4D,#0B5FFF 60%,#5B9BFF); padding: 28px 30px; text-align: center;">' +
    '<div style="color: #FFE08A; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; font-weight: bold; margin-bottom: 6px;">' + instName + '</div>' +
    '<h1 style="color: #ffffff; font-size: 22px; margin: 0; font-weight: 700;">' + title + '</h1>' +
    '</td></tr>' +
    // Body
    '<tr><td style="padding: 32px 30px; font-size: 15px; line-height: 1.6; color: #0B1530;">' +
    bodyContent +
    btnHtml +
    '</td></tr>' +
    // Footer
    '<tr><td style="background-color: #F8FAFC; padding: 20px 30px; text-align: center; border-top: 1px solid #E2E8F0; font-size: 12px; color: #64748B;">' +
    '<p style="margin: 0 0 6px 0; font-weight: bold; color: #061B4D;">' + instName + '</p>' +
    '<p style="margin: 0;">Kerala, India | Official Operations & Placement Desk</p>' +
    '<p style="margin: 6px 0 0 0; font-size: 11px; color: #94A3B8;">This is an automated administrative notification generated by MLC ERP.</p>' +
    '</td></tr>' +
    '</table></td></tr></table></body></html>';
}

/**
 * Dispatch Email with Quota Verification & Logging
 */
function sendEmailWithLog(toEmail, subject, htmlBody, attachments, templateName, senderEmail, senderName) {
  if (!toEmail) return { ok: false, error: 'Recipient email missing' };

  var quota = MailApp.getRemainingDailyQuota();
  if (quota <= 0) {
    insertRecord('EmailLog', {
      recipient_email: toEmail,
      template_name: templateName,
      subject: subject,
      status: 'FAILED_QUOTA',
      error_message: 'Daily Gmail sending quota exhausted',
      sent_at: ''
    }, 'SYSTEM');
    return { ok: false, error: 'Gmail daily sending quota exhausted' };
  }

  try {
    var fromName = senderName || CONFIG.getSenderName();
    var replyToEmail = senderEmail || CONFIG.getPlacementSenderEmail();

    var mailOptions = {
      to: toEmail,
      subject: subject,
      htmlBody: htmlBody,
      name: fromName,
      replyTo: replyToEmail
    };

    // If alias is registered in the deploying Gmail account, specify 'from'
    if (senderEmail) {
      try {
        var aliases = GmailApp.getAliases ? GmailApp.getAliases() : [];
        if (aliases.indexOf(senderEmail) !== -1) {
          mailOptions.from = senderEmail;
        }
      } catch (aliasErr) {
        // Fallback to replyTo + display name
      }
    }

    if (attachments && attachments.length) {
      mailOptions.attachments = attachments;
    }

    MailApp.sendEmail(mailOptions);

    insertRecord('EmailLog', {
      recipient_email: toEmail,
      template_name: templateName,
      subject: subject,
      status: 'SENT',
      error_message: '',
      sent_at: new Date().toISOString()
    }, 'SYSTEM');

    return { ok: true };
  } catch (err) {
    insertRecord('EmailLog', {
      recipient_email: toEmail,
      template_name: templateName,
      subject: subject,
      status: 'ERROR',
      error_message: err.toString(),
      sent_at: ''
    }, 'SYSTEM');
    return { ok: false, error: err.toString() };
  }
}

/**
 * 1. Agreement Email with PDF
 */
function sendAgreementEmail(student, pdfUrl, pdfBlob) {
  var subject = 'Signed Training Agreement Confirmation — ' + student.admission_no;
  var body = '<p>Dear <b>' + student.full_name + '</b>,</p>' +
    '<p>Welcome to Mastered Skill Academy! Your official training agreement has been processed, verified, and safely archived into our registry.</p>' +
    '<p>Please find attached your verified agreement copy for your personal records.</p>' +
    '<div style="background-color: #F1F5F9; border-left: 4px solid #0B5FFF; padding: 12px 16px; margin: 20px 0; border-radius: 4px;">' +
    '<b>Admission Number:</b> ' + student.admission_no + '<br/>' +
    '<b>Course:</b> ' + student.course_code + '<br/>' +
    '<b>Status:</b> Agreement Registered & Active' +
    '</div>' +
    '<p>Next Step: Your placement coordinator will be in touch to record your career preferences.</p>';

  var html = wrapEmailTemplate('Training Agreement Confirmation', body, pdfUrl ? { text: 'View Document in Drive', url: pdfUrl } : null);
  var attachments = pdfBlob ? [pdfBlob] : [];
  var targetEmail = student.personal_email || student.professional_email;

  return sendEmailWithLog(targetEmail, subject, html, attachments, 'AGREEMENT_CONFIRMATION');
}

